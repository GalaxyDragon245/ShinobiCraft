{
	"format_version": "1.8.0",
	"animations": {
		"chidori.create": {
			"loop": "hold_on_last_frame",
			"animation_length": 1,
			"bones": {
				"bone": {
					"scale": {
						"0.0": {
							"post": [0, 0, 0],
							"lerp_mode": "catmullrom"
						},
						"1.0": {
							"post": [1, 1, 1],
							"lerp_mode": "catmullrom"
						}
					}
				}
			}
		},
		"chidori.extinguish": {
			"loop": "hold_on_last_frame",
			"animation_length": 0.5,
			"bones": {
				"bone": {
					"scale": {
						"0.0": [1, 1, 1],
						"0.5": [0, 0, 0]
					}
				}
			}
		}
	}
}